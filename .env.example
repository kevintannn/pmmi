# =============================================================================
# PMMI — Environment Variables
# Copy this file to `.env` (local) and set the same values in Vercel.
# =============================================================================

# --- Neon PostgreSQL (free tier) ---------------------------------------------
# Pooled connection string (used by the app at runtime via @prisma/client).
# Get it from the Neon dashboard → Connection Details → "Pooled connection".
# Must include `?sslmode=require`.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Direct (non-pooled) connection string, used by Prisma Migrate / db push only.
# Neon dashboard → Connection Details → uncheck "Pooled connection".
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Site configuration ------------------------------------------------------
# Canonical, publicly reachable URL (no trailing slash). Used for SEO metadata,
# sitemap.xml, robots.txt and Open Graph tags. In production set this to the
# real domain; locally use http://localhost:3000.
NEXT_PUBLIC_SITE_URL="https://permaimetal.com"

# --- SEO ---------------------------------------------------------------------
# Google Search Console verification token (from the "HTML tag" method — just
# the content value, not the whole tag). Renders <meta name="google-site-
# verification" ...>. Optional; leave unset if verifying via DNS.
GOOGLE_SITE_VERIFICATION=""

# --- Vercel Blob (résumé uploads in production) ------------------------------
# Auto-added to your Vercel project when you connect a Blob store
# (Vercel dashboard → Storage → Create → Blob → Connect Project).
# When set, résumé uploads go to Blob; when unset, they fall back to the local
# /public/uploads folder (fine for local dev). Pull it locally with:
#   vercel env pull .env.local
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxx"
